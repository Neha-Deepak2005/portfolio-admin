# URL of the Flask CMS backend.
# Leave empty in development (Vite proxies /api and /uploads to http://localhost:5000).
# When deployed, set it to your backend, e.g. https://portfolio-cms-api.onrender.com
VITE_API_URL=

# URL of the public portfolio website (used by the "View site" button)
VITE_SITE_URL=http://localhost:3000
